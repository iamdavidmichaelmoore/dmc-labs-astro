---
/* Inline before paint: pairs with light-first tokens in global.css.
   Storage key dmc-labs-theme; first visit follows prefers-color-scheme. */
---
<script is:inline>
  (() => {
    const storedTheme = localStorage.getItem('dmc-labs-theme');
    const theme = storedTheme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  })();
</script>
