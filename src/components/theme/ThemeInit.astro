---
import { darkTheme, lightTheme, themeToCssVars } from '../../styles/themeTokens';

const lightVars = themeToCssVars(lightTheme);
const darkVars = themeToCssVars(darkTheme);

const formatBlock = (selector: string, vars: Record<string, string>) =>
  `${selector} {\n${Object.entries(vars)
    .map(([key, value]) => `  ${key}: ${value};`)
    .join('\n')}\n}`;

const themeCss = [formatBlock(':root', lightVars), formatBlock(":root[data-theme='dark']", darkVars)].join('\n');
---
<style is:inline set:html={themeCss}></style>
<script is:inline>
  (() => {
    const storedTheme = localStorage.getItem('dmc-labs-theme');
    const theme = storedTheme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    document.documentElement.dataset.theme = theme;
  })();
</script>
