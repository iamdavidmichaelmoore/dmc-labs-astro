---
import { codeToHtml, type BundledLanguage } from 'shiki';
import { darkTheme, lightTheme } from '../../styles/themeTokens';

interface Props {
  code: string;
  language?: string;
  title: string;
}

const { code, language = 'text', title } = Astro.props;

/** Clay-on-paper syntax colors aligned with editorial tokens (no CRT green/red/yellow). */
const lightSyntax = {
  bg: '#FBF6EE',
  fg: lightTheme.ink,
  comment: '#8A8276',
  string: '#A64C1F',
  keyword: lightTheme.accent,
  function: '#5F594E',
} as const;

const darkSyntax = {
  bg: darkTheme.surface,
  fg: darkTheme.ink,
  comment: '#7A746A',
  string: '#E0BC6A',
  keyword: darkTheme.accent,
  function: '#A39E94',
} as const;

const highlightedCode = await codeToHtml(code, {
  lang: language as BundledLanguage,
  themes: {
    light: {
      name: 'dmc-light',
      type: 'light',
      colors: {
        'editor.background': lightSyntax.bg,
        'editor.foreground': lightSyntax.fg,
      },
      tokenColors: [
        { scope: ['comment'], settings: { foreground: lightSyntax.comment } },
        { scope: ['string', 'constant.numeric', 'constant.language'], settings: { foreground: lightSyntax.string } },
        { scope: ['keyword', 'storage', 'keyword.control'], settings: { foreground: lightSyntax.keyword } },
        { scope: ['entity.name.function', 'support.function', 'entity.name.type', 'support.type'], settings: { foreground: lightSyntax.function } },
      ],
    },
    dark: {
      name: 'dmc-dark',
      type: 'dark',
      colors: {
        'editor.background': darkSyntax.bg,
        'editor.foreground': darkSyntax.fg,
      },
      tokenColors: [
        { scope: ['comment'], settings: { foreground: darkSyntax.comment } },
        { scope: ['string', 'constant.numeric', 'constant.language'], settings: { foreground: darkSyntax.string } },
        { scope: ['keyword', 'storage', 'keyword.control'], settings: { foreground: darkSyntax.keyword } },
        { scope: ['entity.name.function', 'support.function', 'entity.name.type', 'support.type'], settings: { foreground: darkSyntax.function } },
      ],
    },
  },
  defaultColor: false,
});
---

<figure class="code-panel" data-code-panel>
  <figcaption>
    <span>{title}</span>
    <button type="button" aria-label={`Copy ${title}`} data-copy-code>Copy</button>
  </figcaption>
  <Fragment set:html={highlightedCode} />
</figure>

<script>
  function setupCodePanels() {
    document.querySelectorAll<HTMLElement>('[data-code-panel]').forEach(panel => {
      if (panel.dataset.ready === 'true') return;

      panel.dataset.ready = 'true';
      const button = panel.querySelector<HTMLButtonElement>('[data-copy-code]');
      const code = panel.querySelector('code');
      if (!button || !code) return;

      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(code.textContent ?? '');
        const original = button.textContent;
        button.textContent = 'Copied';
        window.setTimeout(() => {
          button.textContent = original;
        }, 1_500);
      });
    });
  }

  setupCodePanels();
  document.addEventListener('astro:page-load', setupCodePanels);
</script>
