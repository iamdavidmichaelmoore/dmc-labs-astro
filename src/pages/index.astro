---
import { ClientRouter } from 'astro:transitions';
import { MainLayout } from '../components/layout/MainLayout';
import { ExperienceLayer } from '../components/features/ExperienceLayer';
import ThemeInit from '../components/theme/ThemeInit.astro';
import ThemeToggle from '../components/theme/ThemeToggle.astro';
import { LatestNoteHero } from '../components/home/LatestNoteHero';
import { AlsoRunning } from '../components/home/AlsoRunning';
import { getActiveExperiments, getLatestNote, posts, works } from '../data/site';
import '../styles/global.css';

const pageTitle = 'DMC Labs — We try things. We write them down.';
const latestNote = getLatestNote(posts);
const activeExperiments = getActiveExperiments(works);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <ThemeInit />
    <ClientRouter />
  </head>
  <body>
    <MainLayout title={pageTitle} activePath="/">
      <LatestNoteHero note={latestNote} />
      <AlsoRunning experiments={activeExperiments} />
    </MainLayout>
    <ExperienceLayer client:load />
    <ThemeToggle />
  </body>
</html>
