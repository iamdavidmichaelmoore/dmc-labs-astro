---
import { posts } from '../../data/site';

export function getStaticPaths() {
  return posts
    .filter((post): post is typeof post & { slug: string } => Boolean(post.slug))
    .map(post => ({
      params: { slug: post.slug },
    }));
}

const { slug } = Astro.params;
return Astro.redirect(`/notes/${slug}`, 301);
---
