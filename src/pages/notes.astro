---
import { ClientRouter } from 'astro:transitions';
import { MainLayout } from '../components/layout/MainLayout';
import { ExperienceLayer } from '../components/features/ExperienceLayer';
import ThemeInit from '../components/theme/ThemeInit.astro';
import ThemeToggle from '../components/theme/ThemeToggle.astro';
import { posts } from '../data/site';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Notes | DMC Labs</title>
    <ThemeInit />
    <ClientRouter />
  </head>
  <body>
    <MainLayout title="Notes | DMC Labs" activePath="/notes">
      <section
        class="mx-auto max-w-300 px-6 pb-16 pt-35 max-md:px-4 max-md:pb-12 max-md:pt-28"
        data-reveal
        data-section="NOTES"
      >
        <header class="mb-12 max-w-2xl">
          <h1 class="font-display text-[clamp(2rem,5vw,3rem)] font-bold tracking-tight text-[var(--text-primary)]">
            Notes
          </h1>
          <p class="mt-4 font-body text-lg leading-relaxed text-[var(--text-secondary)]">
            Research notes, experiment write-ups, and what held up after we tried it. We write things down so the next run starts smarter.
          </p>
        </header>
        <ul class="m-0 flex list-none flex-col gap-10 p-0">
          {posts.map(post => (
            <li class="border-b border-[var(--surface-border)] pb-10 last:border-b-0">
              <p class="mb-2 font-utility text-[0.75rem] font-semibold uppercase tracking-[0.12em] text-[var(--text-faint)]">
                {post.date}
              </p>
              <h2 class="font-display text-2xl font-semibold tracking-tight text-[var(--text-primary)]">
                {post.slug ? (
                  <a
                    href={`/notes/${post.slug}`}
                    class="text-[var(--text-primary)] no-underline transition-colors hover:text-[var(--accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
                  >
                    {post.title}
                  </a>
                ) : (
                  post.title
                )}
              </h2>
              <p class="mt-3 max-w-2xl font-body text-base leading-relaxed text-[var(--text-secondary)]">
                {post.description}
              </p>
              {post.slug && (
                <a
                  href={`/notes/${post.slug}`}
                  class="mt-4 inline-flex items-center gap-2 font-body text-sm font-semibold text-[var(--accent)] no-underline transition-colors hover:text-[var(--accent-dim)]"
                >
                  Read the note <span aria-hidden="true">→</span>
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    </MainLayout>
    <ExperienceLayer client:load />
    <ThemeToggle />
  </body>
</html>
