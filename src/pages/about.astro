---
import { ClientRouter } from 'astro:transitions';
import { MainLayout } from '../components/layout/MainLayout';
import { ExperienceLayer } from '../components/features/ExperienceLayer';
import ThemeInit from '../components/theme/ThemeInit.astro';
import ThemeToggle from '../components/theme/ThemeToggle.astro';
import { focusAreas, milestones } from '../data/site';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>About | DMC Labs</title>
    <ThemeInit />
    <ClientRouter />
  </head>
  <body>
    <MainLayout title="About | DMC Labs" activePath="/about">
      <section
        class="mx-auto max-w-300 px-6 pb-16 pt-35 max-md:px-4 max-md:pb-12 max-md:pt-28"
        data-reveal
        data-section="ABOUT"
      >
        <header class="mb-12 max-w-2xl">
          <h1 class="font-display text-[clamp(2rem,5vw,3rem)] font-bold tracking-tight text-[var(--text-primary)]">
            About the lab
          </h1>
          <p class="mt-4 font-body text-lg leading-relaxed text-[var(--text-secondary)]">
            DMC Labs is an independent builder lab founded by David Moore. We run experiments, write notes on what we learn, and leave the rest on the cutting-room floor.
          </p>
        </header>

        <div id="story" class="about-story mx-auto max-w-2xl">
          <p class="font-body text-base leading-relaxed text-[var(--text-primary)]">
            The lab started as a side project on efficient attention and grew into a public shelf of systems, tools, and research notes. We care less about bigger models for their own sake and more about making AI useful, inspectable, and practical for real work.
          </p>
          <p class="mt-5 font-body text-base leading-relaxed text-[var(--text-secondary)]">
            Work is reproducible where it can be, open-source when it helps, and grounded in problems we have actually tried to solve. Based in San Francisco, collaborating with researchers and builders wherever they are.
          </p>
        </div>

        <div id="focus" class="mt-20 max-w-2xl" data-reveal data-section="FOCUS AREAS">
          <h2 class="font-display text-2xl font-semibold tracking-tight text-[var(--text-primary)]">
            Focus areas
          </h2>
          <p class="mt-3 font-body text-base leading-relaxed text-[var(--text-secondary)]">
            Directions we return to when choosing the next experiment.
          </p>
          <ul class="m-0 mt-8 flex list-none flex-col gap-0 p-0">
            {focusAreas.map(area => (
              <li class="border-b border-[color-mix(in_srgb,var(--surface-border)_70%,transparent)] py-6 first:pt-0 last:border-b-0">
                <h3 class="font-display text-lg font-semibold tracking-tight text-[var(--text-primary)]">
                  {area.title}
                </h3>
                <p class="mt-2 font-body text-base leading-relaxed text-[var(--text-secondary)]">
                  {area.description}
                </p>
              </li>
            ))}
          </ul>
        </div>

        <div id="timeline" class="mt-20 max-w-2xl" data-reveal data-section="TIMELINE">
          <h2 class="font-display text-2xl font-semibold tracking-tight text-[var(--text-primary)]">
            How it started
          </h2>
          <p class="mt-3 font-body text-base leading-relaxed text-[var(--text-secondary)]">
            A short timeline of moments that shaped the lab.
          </p>
          <div class="mt-8">
            {milestones.map(milestone => (
              <article class="grid grid-cols-[5.5rem_1fr] gap-6 border-b border-[color-mix(in_srgb,var(--surface-border)_55%,transparent)] py-6 last:border-b-0 max-md:grid-cols-1 max-md:gap-2">
                <div class="font-utility text-sm font-semibold tracking-[0.08em] text-[var(--accent-dim)]">
                  {milestone.year}
                </div>
                <div>
                  <h3 class="font-display text-lg font-semibold tracking-tight text-[var(--text-primary)]">
                    {milestone.title}
                  </h3>
                  <p class="mt-2 font-body text-base leading-relaxed text-[var(--text-secondary)]">
                    {milestone.description}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </div>

        <aside
          id="contact-cta"
          class="mt-20 max-w-2xl rounded-[var(--radius-md,0.75rem)] border border-[color-mix(in_srgb,var(--surface-border)_60%,transparent)] bg-[var(--surface)] px-6 py-8"
          data-reveal
          data-section="CONTACT"
        >
          <h2 class="font-display text-xl font-semibold tracking-tight text-[var(--text-primary)]">
            Say hello
          </h2>
          <p class="mt-3 font-body text-base leading-relaxed text-[var(--text-secondary)]">
            Building in public. If something here resonates — a note, an experiment, or a shared problem — reach out.
          </p>
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
            <a
              href="mailto:hello@dmc-labs.io"
              class="font-body text-sm font-semibold text-[var(--accent)] no-underline transition-colors hover:text-[var(--accent-dim)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
            >
              Email the lab
            </a>
            <a
              href="https://github.com/iamdavidmichaelmoore"
              rel="noopener noreferrer"
              target="_blank"
              class="font-body text-sm font-semibold text-[var(--accent)] no-underline transition-colors hover:text-[var(--accent-dim)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
            >
              GitHub
            </a>
          </div>
        </aside>
      </section>
    </MainLayout>
    <ExperienceLayer client:load />
    <ThemeToggle />
  </body>
</html>
